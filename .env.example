# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Storage & Processing
STORAGE_PROVIDER=local
STORAGE_LOCATION=./data/uploads
STORAGE_BUCKET=readico-documents

# RAG & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
BATCH_SIZE=200

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB
VECTOR_DB_TYPE=faiss
VECTOR_DB_STORAGE_DIR=./data/faiss_index

# Relational Metadata DB
DB_DRIVER=postgresql
DB_USER=readico_user
DB_PASSWORD=readico_password
DB_HOST=db
DB_PORT=5432
DB_NAME=readico_db