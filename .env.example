# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Storage & Processing
STORAGE_PROVIDER=local
STORAGE_LOCATION=./data/uploads
STORAGE_BUCKET=readico-documents

# RAG & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
BATCH_SIZE=200

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents